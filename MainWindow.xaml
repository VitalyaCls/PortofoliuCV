<Window x:Class="SalonFrumusete.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salon de Frumusețe - Management Programări"
        Height="550" Width="850"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F0F0F0" Padding="5">
            <MenuItem Header="_Fișier">
                <MenuItem Header="_Ieșire" Click="MeniuIesire_Click"/>
            </MenuItem>
            <MenuItem Header="_Ajutor">
                <MenuItem Header="_Despre" Click="MeniuDespre_Click"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#27AE60" Padding="10" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                
                <!-- 1. Pieptene Vectorial Animat (Stânga) -->
                <Viewbox Width="35" Height="35" Margin="0,0,20,0">
                    <Canvas Width="100" Height="100">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="CombRotateTransform" CenterX="50" CenterY="50" Angle="0"/>
                        </Canvas.RenderTransform>
                        <Rectangle Canvas.Left="10" Canvas.Top="35" Width="80" Height="16" Fill="White" RadiusX="3" RadiusY="3"/>
                        <Rectangle Canvas.Left="18" Canvas.Top="51" Width="4" Height="15" Fill="White"/>
                        <Rectangle Canvas.Left="28" Canvas.Top="51" Width="4" Height="15" Fill="White"/>
                        <Rectangle Canvas.Left="38" Canvas.Top="51" Width="4" Height="15" Fill="White"/>
                        <Rectangle Canvas.Left="48" Canvas.Top="51" Width="4" Height="15" Fill="White"/>
                        <Rectangle Canvas.Left="58" Canvas.Top="51" Width="4" Height="15" Fill="White"/>
                        <Rectangle Canvas.Left="68" Canvas.Top="51" Width="4" Height="15" Fill="White"/>
                        <Rectangle Canvas.Left="78" Canvas.Top="51" Width="4" Height="15" Fill="White"/>
                    </Canvas>
                    <Viewbox.Triggers>
                        <EventTrigger RoutedEvent="Viewbox.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CombRotateTransform" 
                                                     Storyboard.TargetProperty="Angle" 
                                                     From="0" To="360" Duration="0:0:8" 
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Viewbox.Triggers>
                </Viewbox>

                <!-- 2. Titlul Salonului -->
                <TextBlock Text="SALON DE FRUMUSEȚE - ELEGANCE" 
                           Foreground="White" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center"/>

                <!-- 3. Foarfecă Vectorială Animatǎ (Dreapta) -->
                <Viewbox Width="35" Height="35" Margin="20,0,0,0">
                    <Canvas Width="100" Height="100">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="ScissorsRotateTransform" CenterX="50" CenterY="50" Angle="0"/>
                        </Canvas.RenderTransform>
                        <Ellipse Canvas.Left="20" Canvas.Top="60" Width="20" Height="20" Stroke="White" StrokeThickness="3"/>
                        <Ellipse Canvas.Left="60" Canvas.Top="60" Width="20" Height="20" Stroke="White" StrokeThickness="3"/>
                        <Path Stroke="White" StrokeThickness="3" Data="M32,65 L70,30 M70,65 L32,30"/>
                    </Canvas>
                    <Viewbox.Triggers>
                        <EventTrigger RoutedEvent="Viewbox.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ScissorsRotateTransform" 
                                                     Storyboard.TargetProperty="Angle" 
                                                     From="360" To="0" Duration="0:0:8" 
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Viewbox.Triggers>
                </Viewbox>

            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <GroupBox Header="Adăugare Programare Nouă" Grid.Column="0" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Nume Client:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtNumeClient"
                             Text="{Binding NumeClient, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="0,0,0,15" />

                    <TextBlock Text="Serviciu Solicitat:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbServiciu"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding ServiciuSelectat}"
                              Height="30"
                              Margin="0,0,0,15">
                        <ComboBoxItem Content="Tuns / Coafat" />
                        <ComboBoxItem Content="Manichiură / Pedichiură" />
                        <ComboBoxItem Content="Tratament Facial" />
                        <ComboBoxItem Content="Machiaj Profesional" />
                    </ComboBox>

                    <TextBlock Text="Data Programării:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpDataProgramarii"
                                SelectedDate="{Binding DataProgramare}"
                                Height="30"
                                Margin="0,0,0,15" />
                    <Button Content="Salvează Programarea"
                            Command="{Binding AdaugaProgramareCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </GroupBox>
            
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCC"/>

            <GroupBox Header="Programări Existente"
                      Grid.Column="2"
                      Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="lstProgramari"
                             ItemsSource="{Binding ListaProgramari}"
                             SelectedItem="{Binding SelectedProgramare, Mode=TwoWay}"
                             Margin="5" />

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="5">
                        <Button Content="Exportă CSV"
                                Command="{Binding ExportCsvCommand}"
                                Width="100"
                                Height="30"
                                Margin="0,0,10,0"
                                Background="#27AE60"
                                Foreground="White"
                                FontWeight="Bold" />
                        <Button Content="Editează"
                                Command="{Binding EditeazaProgramareCommand}"
                                Width="100"
                                Height="30"
                                Margin="0,0,10,0"
                                Background="#27AE60"
                                Foreground="White" />
                        <Button Content="Șterge"
                                Command="{Binding StergeProgramareCommand}"
                                Width="100"
                                Height="30"
                                Background="#27AE60"
                                Foreground="White" />
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="3" Background="#E0E0E0">
            <StatusBarItem x:Name="stbStatus" Content="Gata - Sistem Salon de Frumusețe"/>
        </StatusBar>
    </Grid>
</Window>